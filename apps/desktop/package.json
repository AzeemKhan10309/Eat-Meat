{
  "name": "@eat-and-meet/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "electron": "electron .",
    "bundle:server": "cd ../server && node build-bundle.js",
    "dist:win": "npm run bundle:server && npm run build && electron-builder --win",
    "dist:mac": "npm run bundle:server && npm run build && electron-builder --mac",
    "dist:linux": "npm run bundle:server && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@eat-and-meet/config": "*",
    "@eat-and-meet/types": "*",
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.8.4",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.5",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.9.3",
    "socket.io-client": "^4.6.1",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^27.1.3",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.eatandmeet.pos",
    "productName": "Eat & Meet POS",
    "copyright": "Copyright © 2024 Eat & Meet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../server/dist/bundle.js",
        "to": "server/bundle.js"
      },
      {
        "from": "../server/.env.production",
        "to": "server/.env"
      },
      {
        "from": "../../node_modules/@prisma/client",
        "to": "server/node_modules/@prisma/client"
      },
      {
        "from": "../../node_modules/.prisma/client",
        "to": "server/node_modules/.prisma/client"
      },
      {
        "from": "../../node_modules/node-thermal-printer",
        "to": "server/node_modules/node-thermal-printer"
      },
      {
        "from": "../../node_modules/iconv-lite",
        "to": "server/node_modules/iconv-lite"
      },
      {
        "from": "../../node_modules/pngjs",
        "to": "server/node_modules/pngjs"
      },
      {
        "from": "../../node_modules/unorm",
        "to": "server/node_modules/unorm"
      },
      {
        "from": "../../node_modules/write-file-queue",
        "to": "server/node_modules/write-file-queue"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": null
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
